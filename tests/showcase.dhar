task greet():
    lock msg: str = "Hello from Dhar!"
    sys 1, 1, msg, 16

task calculate():
    flux state: i32 = 1
    flux result: str
    
    when state == 1:
        result = "Math logic check: PASS"
        flux temp_buffer: raw[1024]
        state = state + 1
    fallback:
        result = "Math logic check: FAIL"
        flux error_buffer: raw[2048]
        
    sys 1, 1, result, 22

task loop_test():
    flux iter: i32 = 1
    
    span iter == 1:
        lock loop_msg: str = "Loop executed!"
        sys 1, 1, loop_msg, 14
        iter = iter + 1

task core():
    greet()
    calculate()
    loop_test()
    
    lock exit_msg: str = "Done."
    sys 1, 1, exit_msg, 5