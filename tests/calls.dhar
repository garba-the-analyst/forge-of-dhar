flux buf: raw[8]
task add(a: i32, b: i32):
    flux r: i32 = 0
    r = a + b
    give r
task sub3(a: i32, b: i32, c: i32):
    flux r: i32 = 0
    r = a - b
    r = r - c
    give r
task f():
    flux r: i32 = 5
    give r
task g(a: i32):
    flux r: i32 = 0
    r = a + 1
    give r
task core():
    flux res: i32 = 0
    flux z: i32 = 0
    flux t: i32 = 0
    t = add(2, 3)
    res = res + t
    t = sub3(10, 3, 2)
    res = res + t
    t = f()
    res = res + t
    t = g(41)
    res = res + t
    buf[z] = res
    sys 1, 1, buf, 8
